# Copy to .env and fill in locally. .env is gitignored. Do not commit real values.
# Docker Compose reads .env in this directory when interpolating ${CHIDFLOW_SIGNING_SECRET}.

# HMAC key for `chid serve-clearing`, `chid verify` (unless --secret is passed),
# and policy files that set "signing_secret": "$ENV:CHIDFLOW_SIGNING_SECRET"
# (see examples/policy.json). Demo commands do not need this.
CHIDFLOW_SIGNING_SECRET=

# Read by examples/policy.json via "$ENV:STRIPE_API_KEY".
STRIPE_API_KEY=
